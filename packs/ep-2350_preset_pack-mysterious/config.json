{
  "name": "MYSTERIOUS PACK",
  "presets": [
    {
      "pos": 0,
      "name": "MANUAL PITCHER",
      "comment": "handle acts as a pitch wheel. 0% = deep, 100% = High.",
      "list": [
        {
          "effect": "HARMONY",
          "pitch": 0.5,
          "dry-level": 0.0
        },
        {
          "effect": "REVERB",
          "time": 0.2,
          "wet-level": 0.3
        },
        {
          "effect": "SAMPLE"
        }
      ],
      "handle": {
        "row": 0,
        "param": "pitch",
        "depth": 1.5
      },
      "shake": {
        "row": 1,
        "param": "wet-level",
        "depth": 0.5
      },
      "trigger": {
        "row": 2
      }
    },
    {
      "pos": 1,
      "name": "DEEP TRAP",
      "comment": "push handle to drop pitch down one octave. shake for dirt.",
      "list": [
        {
          "effect": "HARMONY",
          "pitch": 1.0,
          "dry-level": 0.6
        },
        {
          "effect": "DIST",
          "amount": 0.0,
          "mix": 0.0
        },
        {
          "effect": "SAMPLE"
        }
      ],
      "handle": {
        "row": 0,
        "param": "pitch",
        "depth": -0.5
      },
      "shake": {
        "row": 1,
        "param": "mix",
        "depth": 1.0
      },
      "trigger": {
        "row": 2
      }
    },
    {
      "pos": 2,
      "name": "HYPER POP",
      "comment": "push handle to pitch up. constant lfo vibrato.",
      "list": [
        {
          "effect": "HARMONY",
          "pitch": 1.0,
          "dry-level": 0.0
        },
        {
          "effect": "DELAY",
          "time": 0.3,
          "echo": 0.4
        },
        {
          "effect": "SAMPLE"
        }
      ],
      "handle": {
        "row": 0,
        "param": "pitch",
        "depth": 1.0
      },
      "lfo": {
        "row": 0,
        "param": "pitch",
        "depth": 0.1,
        "shape": "sine",
        "speed": 6.0
      },
      "trigger": {
        "row": 2
      }
    },
    {
      "pos": 3,
      "name": "ALIEN TUNE",
      "comment": "handle sets pitch. shake changes the robotic ring freq.",
      "list": [
        {
          "effect": "HARMONY",
          "pitch": 0.8,
          "dry-level": 0.2
        },
        {
          "effect": "RING",
          "frequency": 400.0,
          "mix": 0.4
        },
        {
          "effect": "SAMPLE"
        }
      ],
      "handle": {
        "row": 0,
        "param": "pitch",
        "depth": 0.8
      },
      "shake": {
        "row": 1,
        "param": "frequency",
        "depth": 1000.0
      },
      "trigger": {
        "row": 2
      }
    }
  ]
}